# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Trello (API Key do Power-Up / app developer)
# ---------------------------------------------------------------------------
TRELLO_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública do serviço (Render, ngrok, domínio). Sem barra no final.
# Local com ngrok: https://xxxx.ngrok-free.app
BASE_URL=https://seu-servico.onrender.com
APP_NAME=ResumeAI
PORT=10000

# ---------------------------------------------------------------------------
# PostgreSQL
# - Com docker-compose, o serviço app sobrescreve DATABASE_URL para o host "db".
# - Em Render / cloud, use a connection string fornecida pelo provedor.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://resumeai:resumeai_secret@localhost:5432/resumeai
POSTGRES_USER=resumeai
POSTGRES_PASSWORD=resumeai_secret
POSTGRES_DB=resumeai
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Google OAuth (atas automáticas — opcional até configurar)
# Redirect URI no Google Cloud: {BASE_URL}/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Atas / tema (opcionais)
# ---------------------------------------------------------------------------
ATAS_POLL_SECONDS=900
ATAS_LOOKBACK_DAYS=3
# ATAS_GMAIL_QUERY=newer_than:{days}d from:gemini-notes@google.com subject:Anotações
THEME_MATCH_THRESHOLD=0.85
MAX_IMAGES=5
