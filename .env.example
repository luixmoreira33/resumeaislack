# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Trello (API Key do Power-Up / app developer)
# ---------------------------------------------------------------------------
TRELLO_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública do serviço (OKD Route, Render, ngrok, domínio). Sem barra no final.
BASE_URL=https://resumeai.apps.seu-cluster.example.com
APP_NAME=ResumeAI
PORT=10000

# ---------------------------------------------------------------------------
# PostgreSQL
# - Com docker-compose, o serviço app sobrescreve DATABASE_URL para o host "db".
# - Em cloud / OKD, use a connection string do serviço de banco.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://resumeai:resumeai_secret@localhost:5432/resumeai
POSTGRES_USER=resumeai
POSTGRES_PASSWORD=resumeai_secret
POSTGRES_DB=resumeai
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Google OAuth (atas automáticas — opcional até configurar)
# Redirect URI no Google Cloud: {BASE_URL}/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Atas / tema (opcionais)
# ---------------------------------------------------------------------------
ATAS_POLL_SECONDS=900
ATAS_LOOKBACK_DAYS=3
# ATAS_GMAIL_QUERY=newer_than:{days}d from:gemini-notes@google.com subject:Anotações
THEME_MATCH_THRESHOLD=0.85
MAX_IMAGES=5

# ---------------------------------------------------------------------------
# AWS SSM Parameter Store (OKD / cloud)
# Se SSM_PREFIX estiver definido, o app carrega /prefix/* no boot.
# Variáveis já presentes no ambiente do pod (Secret/ConfigMap) NÃO são
# sobrescritas pelo SSM.
#
# Exemplos de parâmetros:
#   /resumeai/prod/SLACK_BOT_TOKEN
#   /resumeai/prod/DATABASE_URL
#   /resumeai/prod/GEMINI_API_KEY
#
# Credenciais AWS no pod:
#   - AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN), ou
#   - role/credencial associada ao ServiceAccount
# ---------------------------------------------------------------------------
# SSM_PREFIX=/resumeai/prod
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
